      "parameters": {
        "jsCode": "const jsonbinResponse = $input.first().json;\nconst data = jsonbinResponse.record;\n\nif (!data || !data.resumeUrl) {\n  throw new Error('❌ No resume URL found. Please upload a video first in the main workflow.');\n}\n\nconst resumeUrl = data.resumeUrl;\n\nconsole.log('✅ Found resume URL:', resumeUrl);\nconsole.log('Execution ID:', data.executionId);\nconsole.log('Video ID:', data.videoId);\nconsole.log('Video Name:', data.videoName);\n\n// Get telegram message\nconst message = $('Telegram Trigger').first().json.message;\nconst audioFileId = message.document?.file_id || \n                   message.audio?.file_id || \n                   message.voice?.file_id;\nconst chatId = message.from.id;\n\nif (!audioFileId) {\n  throw new Error('❌ No audio file found in message');\n}\n\nif (data.status !== 'waiting_for_audio') {\n  throw new Error('❌ This workflow is no longer waiting for audio. Please upload a new video.');\n}\n\nreturn {\n  json: {\n    resumeUrl: resumeUrl,\n    audioFileId: audioFileId,\n    chatId: chatId,\n    executionId: data.executionId,\n    videoId: data.videoId,        // ← Add this\n    videoName: data.videoName      // ← Add this\n  }\n};"
